{
  "manifest_version": 2,
  "name": "Password Vault (Local Native Messaging)",
  "version": "0.1.0",
  "description": "Auto-fill e Auto-save integrado ao Password Vault Desktop via Native Messaging + Unix Socket.",
  "browser_specific_settings": {
    "gecko": {
      "id": "password-vault@local.dev",
      "strict_min_version": "109.0"
    }
  },
  "permissions": [
    "nativeMessaging",
    "activeTab",
    "tabs",
    "storage",
    "<all_urls>"
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_action": {
    "default_title": "Password Vault",
    "default_popup": "popup.html"
  }
}
